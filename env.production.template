# 🚀 ERC-8004 A2A PRODUCTION ENVIRONMENT CONFIGURATION
# ================================================================
# Complete configuration for Phala TEE deployment
#
# SECURITY: These values are templates - replace with your actual keys
# NEVER commit real API keys or private keys to version control

# ================================================================
# BLOCKCHAIN CONFIGURATION
# ================================================================
# Base Network RPC via DRPC (replace with your DRPC endpoint)
RPC_URL=https://lb.drpc.org/base-sepolia/YOUR_DRPC_KEY_HERE
CHAIN_ID=84532

# Your deployment wallet private key (for contract deployment and agent registration)
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# ================================================================
# DEPLOYED ERC-8004 CONTRACT ADDRESSES
# ================================================================
# Replace these with your deployed contract addresses after deployment
IDENTITY_REGISTRY_ADDRESS=0x35656CaD817aD468260dE1bA029fF919E5a40f75
REPUTATION_REGISTRY_ADDRESS=0x5796Cf09CF7E0F27A6Fb1489a7e5f9414f95F17B
VALIDATION_REGISTRY_ADDRESS=0x6731b3be764B33a4E94D148410f1f551CE91dA61

# ================================================================
# AI MODEL API CONFIGURATION
# ================================================================
# Grok AI (Primary analysis engine - most cost-effective)
GROK_API_KEY=YOUR_GROK_API_KEY_HERE

# OpenAI (Fallback engine)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Anthropic Claude (Validation engine)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# ================================================================
# PHALA TEE CONFIGURATION
# ================================================================
# Your Phala Cloud API key for TEE deployment
PHALA_API_KEY=YOUR_PHALA_API_KEY_HERE

# TEE configuration
TEE_MODE=production
TEE_ATTESTATION_ENABLED=true
PHALA_ENDPOINT=https://api.phala.network
DSTACK_SIMULATOR_ENDPOINT=https://phat-cluster-api.phala.network

# ================================================================
# BLOCKCHAIN EXPLORER INTEGRATION
# ================================================================
# Etherscan API for transaction verification (Base network)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY_HERE

# ================================================================
# FRONTEND CONFIGURATION
# ================================================================
# API endpoints (adjust if running on different ports/domains)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_VALIDATOR_URL=http://localhost:8081

# Blockchain configuration for frontend
NEXT_PUBLIC_RPC_URL=https://lb.drpc.org/base-sepolia/YOUR_DRPC_KEY_HERE
NEXT_PUBLIC_CHAIN_ID=84532

# Contract addresses for frontend
NEXT_PUBLIC_IDENTITY_REGISTRY=0x35656CaD817aD468260dE1bA029fF919E5a40f75
NEXT_PUBLIC_VALIDATION_REGISTRY=0x6731b3be764B33a4E94D148410f1f551CE91dA61

# Etherscan integration for frontend
NEXT_PUBLIC_ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY_HERE

# Optional: Protocol owner EOA for revenue payments
NEXT_PUBLIC_PROTOCOL_OWNER_EOA=YOUR_REVENUE_WALLET_ADDRESS_HERE

# ================================================================
# DEPLOYMENT CONFIGURATION
# ================================================================
NODE_ENV=production
PHALA_DEPLOYMENT=true

# ================================================================
# USAGE INSTRUCTIONS
# ================================================================
# 1. Copy this file to .env: cp env.production.template .env
# 2. Replace all YOUR_*_HERE placeholders with your actual values
# 3. Deploy contracts: forge script script/Deploy.s.sol --rpc-url $RPC_URL --private-key $PRIVATE_KEY --broadcast
# 4. Update contract addresses in this file
# 5. Deploy to Phala: Use Phala CLI with your PHALA_API_KEY
# 6. Launch: ./quick_launch.sh or docker-compose up
# 
# For local testing, use: ./quick_launch.sh
# For Phala TEE deployment: Use Phala CLI with docker-compose.yml
