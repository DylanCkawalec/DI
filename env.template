# 🔐 ERC-8004 Trustless AI - ENVIRONMENT TEMPLATE
# =================================================
# Environment configuration template for Phala TEE deployment
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp env.template .env
# 2. Private keys are GENERATED AT RUNTIME by dstack getKey()
# 3. AI API keys are INJECTED at runtime by Phala Cloud TEE
# 4. Contract addresses are IMMUTABLE and shared across all agents
# 5. Never commit .env file to git - keep your secrets safe!

# =============================================================================
# 🚨 CRITICAL: IMMUTABLE CONTRACT ADDRESSES (REQUIRED)
# =============================================================================
# These addresses are fixed and shared across all agent deployments
# DO NOT CHANGE THESE - they are the canonical ERC-8004 registry contracts

# Identity Registry - Single contract for all agents on Base Sepolia
IDENTITY_REGISTRY_ADDRESS=0x000c5A70B7269c5eD4238DcC6576e598614d3f70

# TEE Verifier - Handles TEE attestation verification
TEE_VERIFIER_ADDRESS=0x742d35Cc6634C0532925a3b844Bc9e7595f0bEb7

# Validation Registry - Handles validation requests
VALIDATION_REGISTRY_ADDRESS=0x0987654321098765432109876543210987654321

# Reputation Registry - Handles feedback and reputation
REPUTATION_REGISTRY_ADDRESS=0x1234567890123456789012345678901234567890

# Legacy contract address (points to IdentityRegistry)
CONTRACT_ADDRESS=0x000c5A70B7269c5eD4238DcC6576e598614d3f70

# =============================================================================
# 🌐 BLOCKCHAIN CONFIGURATION (REQUIRED)
# =============================================================================

# Base Sepolia RPC URL (get from DRPC, Alchemy, or Infura)
RPC_URL=https://sepolia.base.org

# Blockchain network configuration
CHAIN_ID=84532
NETWORK_NAME=Base Sepolia

# =============================================================================
# 🔑 AGENT IDENTITY CONFIGURATION (GENERATED AT RUNTIME)
# =============================================================================
# These values are used to derive agent keys and domains at runtime
# Private keys are generated by dstack getKey() - DO NOT SET THESE

# Server Agent (Code Review AI) - GENERATED AT RUNTIME
SERVER_AGENT_SALT=erc8004_server_salt_001
SERVER_AGENT_DOMAIN=your-domain.erc8004.dev

# Validator Agent (Review Validator) - GENERATED AT RUNTIME
VALIDATOR_AGENT_SALT=erc8004_validator_salt_001
VALIDATOR_AGENT_DOMAIN=your-domain-validator.erc8004.dev

# Client Agent (Feedback Provider) - GENERATED AT RUNTIME
CLIENT_AGENT_SALT=erc8004_client_salt_001
CLIENT_AGENT_DOMAIN=your-domain-client.erc8004.dev

# Agent configuration - SET YOUR CUSTOM VALUES
AGENT_TYPE=server
AGENT_DOMAIN=your-custom-domain.erc8004.dev

# =============================================================================
# 🌐 FRONTEND CONFIGURATION (GENERATED AT RUNTIME)
# =============================================================================

# Public frontend URLs (set dynamically based on deployment)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_VALIDATOR_URL=http://localhost:8081
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_CHAIN_ID=84532

# Public contract addresses (for frontend) - IMMUTABLE
NEXT_PUBLIC_TEE_VERIFIER=0x742d35Cc6634C0532925a3b844Bc9e7595f0bEb7
NEXT_PUBLIC_IDENTITY_REGISTRY=0x000c5A70B7269c5eD4238DcC6576e598614d3f70
NEXT_PUBLIC_REPUTATION_REGISTRY=0x1234567890123456789012345678901234567890
NEXT_PUBLIC_VALIDATION_REGISTRY=0x0987654321098765432109876543210987654321

# =============================================================================
# 🤖 AI API KEYS (INJECTED BY PHALA CLOUD TEE AT RUNTIME)
# =============================================================================
# These are set automatically by the Phala Cloud environment
# No need to configure - they come from your Phala Cloud deployment settings

# OpenAI API (Primary AI provider for code analysis)
# OPENAI_API_KEY=<INJECTED_BY_PHALA_CLOUD>
OPENAI_MODEL=gpt-4o

# =============================================================================
# 🔐 PHALA TEE CONFIGURATION (AUTO-CONFIGURED)
# =============================================================================

# Phala API Key - INJECTED BY PHALA CLOUD
# PHALA_API_KEY=<INJECTED_BY_PHALA_CLOUD>

# Phala endpoints
PHALA_ENDPOINT=https://api.phala.network
PHALA_ATTESTATION_ENDPOINT=https://api.phala.network/api/v1/attestations

# TEE configuration - AUTO-CONFIGURED BY PHALA CLOUD
TEE_MODE=production
TEE_ATTESTATION_ENABLED=true
TEE_SIMULATION_MODE=false
PHALA_DEPLOYMENT=true
CONTAINER_MODE=true
GRANT_SUDO=yes

# Python configuration
PYTHONPATH=/app
PYTHONUNBUFFERED=1

# Service configuration
HEALTHCHECK_INTERVAL=30000
ENABLE_AUTO_RESTART=true

# API rate limiting
API_RATE_LIMIT=100
API_RATE_WINDOW=60000

# =============================================================================
# 🚀 PRIVATE KEYS GENERATED AT RUNTIME
# =============================================================================
# The following variables are set by the dstack getKey() function at runtime:
#
# PRIVATE_KEY=<GENERATED_BY_DSTACK>
# SERVER_AGENT_PRIVATE_KEY=<GENERATED_BY_DSTACK>
# VALIDATOR_AGENT_PRIVATE_KEY=<GENERATED_BY_DSTACK>
# CLIENT_AGENT_PRIVATE_KEY=<GENERATED_BY_DSTACK>
#
# These keys are NEVER written to disk and exist only in memory during runtime.
