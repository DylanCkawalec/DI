# 🔐 ERC-8004 Trustless AI - ENVIRONMENT TEMPLATE
# =================================================
# Environment configuration template for Phala TEE deployment
# 
# INSTRUCTIONS:
# 1. Copy this file to .env: cp env.template .env
# 2. Fill in all required values (marked with <REQUIRED>)
# 3. Optional values can be left as defaults or customized
# 4. Never commit .env file to git - keep your secrets safe!

# =============================================================================
# 🚨 CRITICAL: BLOCKCHAIN CONFIGURATION (REQUIRED)
# =============================================================================

# Private key for agent transactions (64 hex characters, no 0x prefix)
PRIVATE_KEY=<YOUR_PRIVATE_KEY_HERE>

# Base Sepolia RPC URL (get from DRPC, Alchemy, or Infura)
RPC_URL=<YOUR_RPC_URL_HERE>

# Blockchain network configuration
CHAIN_ID=84532
NETWORK_NAME=Base Sepolia

# =============================================================================
# 🤖 AI API KEYS (AT LEAST ONE REQUIRED)
# =============================================================================

# Grok API (Primary AI provider for code analysis)
GROK_API_KEY=<YOUR_GROK_API_KEY_HERE>
XAI_API_KEY=<YOUR_XAI_API_KEY_HERE>
GROK_FAST_MODEL=grok-3-mini
GROK_STANDARD_MODEL=grok-3

# Claude API (High-quality security analysis)
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY_HERE>
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# OpenAI API (Fallback AI provider)
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY_HERE>
OPENAI_MODEL=gpt-4o

# =============================================================================
# 🔐 PHALA TEE CONFIGURATION (REQUIRED FOR TEE)
# =============================================================================

# Phala API Key
PHALA_API_KEY=<YOUR_PHALA_API_KEY_HERE>

# Phala endpoints
PHALA_ENDPOINT=https://api.phala.network
PHALA_ATTESTATION_ENDPOINT=https://api.phala.network/api/v1/attestations

# TEE configuration
TEE_MODE=production
TEE_ATTESTATION_ENABLED=true
TEE_SIMULATION_MODE=false

# =============================================================================
# 📜 ERC-8004 CONTRACT ADDRESSES (FROM deployed_contracts.json)
# =============================================================================

# TEE-Enhanced contract addresses on Base Sepolia (PRODUCTION V2)
TEE_VERIFIER_ADDRESS=0x1b841e88ba786027f39ecf9Cd160176b22E3603c
IDENTITY_REGISTRY_ADDRESS=0x000c5A70B7269c5eD4238DcC6576e598614d3f70
REPUTATION_REGISTRY_ADDRESS=0xa7b860b16a41Aa8b6990EB3Fec0dB34686f7EAde
VALIDATION_REGISTRY_ADDRESS=0xA455e56CBE75aaa3F692d28d0fBFD1D44B64F70d

# Legacy contract address (updated to new IdentityRegistry)
CONTRACT_ADDRESS=0x000c5A70B7269c5eD4238DcC6576e598614d3f70

# =============================================================================
# 🔑 AGENT IDENTITY CONFIGURATION
# =============================================================================

# Server Agent (Code Review AI)
SERVER_AGENT_PRIVATE_KEY=<AUTO_DERIVED_FROM_TEE_OR_SET_MANUALLY>
SERVER_AGENT_SALT=erc8004_server_salt_001
SERVER_AGENT_DOMAIN=alice-code-review.erc8004.dev

# Validator Agent (Review Validator)  
VALIDATOR_AGENT_PRIVATE_KEY=<AUTO_DERIVED_FROM_TEE_OR_SET_MANUALLY>
VALIDATOR_AGENT_SALT=erc8004_validator_salt_001
VALIDATOR_AGENT_DOMAIN=bob-validator.erc8004.dev

# Client Agent (Feedback Provider)
CLIENT_AGENT_PRIVATE_KEY=<AUTO_DERIVED_FROM_TEE_OR_SET_MANUALLY>
CLIENT_AGENT_SALT=erc8004_client_salt_001
CLIENT_AGENT_DOMAIN=charlie-client.erc8004.dev

# Agent configuration
AGENT_TYPE=server
AGENT_DOMAIN=alice-base-sepolia.erc8004.dev

# =============================================================================
# 🌐 FRONTEND CONFIGURATION
# =============================================================================

# Public frontend URLs (accessible to users)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_VALIDATOR_URL=http://localhost:8081
NEXT_PUBLIC_RPC_URL=<YOUR_PUBLIC_RPC_URL_HERE>
NEXT_PUBLIC_CHAIN_ID=84532

# Public contract addresses (for frontend) - PRODUCTION V2
NEXT_PUBLIC_TEE_VERIFIER=0x1b841e88ba786027f39ecf9Cd160176b22E3603c
NEXT_PUBLIC_IDENTITY_REGISTRY=0x000c5A70B7269c5eD4238DcC6576e598614d3f70
NEXT_PUBLIC_REPUTATION_REGISTRY=0xa7b860b16a41Aa8b6990EB3Fec0dB34686f7EAde
NEXT_PUBLIC_VALIDATION_REGISTRY=0xA455e56CBE75aaa3F692d28d0fBFD1D44B64F70d

# Blockchain explorer
ETHERSCAN_API_KEY=<OPTIONAL_YOUR_ETHERSCAN_API_KEY>
NEXT_PUBLIC_ETHERSCAN_API_KEY=<OPTIONAL_YOUR_ETHERSCAN_API_KEY>

# =============================================================================
# 🚀 APPLICATION CONFIGURATION
# =============================================================================

# Environment mode
NODE_ENV=production
CONTAINER_MODE=true
PHALA_DEPLOYMENT=true
GRANT_SUDO=yes

# Python configuration
PYTHONPATH=/app
PYTHONUNBUFFERED=1

# Service configuration
HEALTHCHECK_INTERVAL=30000
ENABLE_AUTO_RESTART=true

# API rate limiting
API_RATE_LIMIT=100
API_RATE_WINDOW=60000
